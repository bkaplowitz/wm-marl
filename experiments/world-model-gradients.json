{
  "profiles": [
    "smac_vector",
    "ma_jepa",
    "localmask_reference"
  ],
  "wandb": {
    "entity": "osaze-obahor-org",
    "project": "majepa-world-model-gradients"
  },
  "budget": 40,
  "max_gpu_hourly_rate": 1.0,
  "max_hours": 8,
  "max_gpus": 4,
  "gpus_per_pod": 4,
  "allow_a100": false,
  "placements": [
    {
      "region": "SET_DATACENTER_ID",
      "volume": "SET_NETWORK_VOLUME_ID"
    }
  ],
  "storage": {
    "quota_gb": 300,
    "min_free_gb": 20
  },
  "maps": [
    {
      "name": "2s3z",
      "agents": 5,
      "steps": 50000
    }
  ],
  "seeds": [
    0,
    1,
    2
  ],
  "overrides": {
    "agent.dyn.parallel_transformer.deter": 4096,
    "agent.dyn.parallel_transformer.hidden": 512,
    "agent.dyn.parallel_transformer.stoch": 32,
    "agent.dyn.parallel_transformer.classes": 64,
    "agent.policy.layers": 3,
    "agent.policy.units": 512,
    "agent.opt.lr": 0.0001,
    "agent.marl.ctde.opt.lr": 0.0001,
    "agent.ppo.actor_lr": 3e-05,
    "agent.ppo.critic_lr": 3e-05,
    "agent.ppo.entropy_coefficient": 0.003,
    "agent.ppo.entropy_schedule.enabled": false,
    "agent.world_model_gradients.critic_value_scale": 0.0,
    "agent.world_model_gradients.joint_prediction": false
  },
  "treatments": [
    {
      "name": "baseline",
      "overrides": {}
    },
    {
      "name": "critic-value",
      "overrides": {
        "agent.world_model_gradients.critic_value_scale": 0.1
      }
    },
    {
      "name": "joint-gradient",
      "overrides": {
        "agent.world_model_gradients.joint_prediction": true
      }
    },
    {
      "name": "both",
      "overrides": {
        "agent.world_model_gradients.critic_value_scale": 0.1,
        "agent.world_model_gradients.joint_prediction": true
      }
    }
  ]
}
